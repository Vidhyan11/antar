# Copy to .env and fill in. .env is gitignored and never committed.
#
# Razorpay TEST-MODE keys only. Get them at:
#   dashboard.razorpay.com -> Account & Settings -> API Keys -> Generate Key
#   (make sure the dashboard toggle says "Test Mode" -- no KYC required)
#
# The client refuses any key that does not start with rzp_test_, so a live key
# cannot be used here even by accident.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Without it the triage agent replays committed fixtures, then falls
# back to deterministic rules. The demo runs fine with this unset.
GEMINI_API_KEY=
